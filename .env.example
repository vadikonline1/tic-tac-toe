# TIC-TAK-TOK — exemplu variabile de mediu. Copiaza in .env si completeaza.
# Prioritate: ENV > DB. La fiecare boot, valorile setate aici se importa in DB (config.json).
# Ce lipseste din ENV se poate configura din UI (admin) si ramane in DB.

# Portul unic HTTP + WebSocket (default 8000)
PORT=8000

# Email: mode=outbox (fisiere in outbox/ pentru test) sau smtp (trimitere reala via nodemailer)
SMTP_MODE=outbox
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=user@example.com
SMTP_PASS=schimba-ma
SMTP_FROM=noreply@tic-tak-tok.local

# Google AdSense: doar ID-ul de client (ex: ca-pub-9949545458988251).
# Blocul complet (snippet) se lipeste din UI: Admin -> Config -> Bloc AdSense complet.
ADSENSE_CLIENT=

# Cont administrator: creat la primul boot daca lipseste.
# Daca ADMIN_PASSWORD e setat, parola se (re)aplica din ENV la fiecare boot
# iar schimbarea fortata se dezactiveaza. Altfel: Admin123! + schimbare fortata.
ADMIN_EMAIL=admin@matroshka.local
ADMIN_PASSWORD=Admin123!
